{
  "name": "Student AI Agent v2 (Webhook -> FastAPI -> AI with memory)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "student-chat",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "b2c3d4e5-0001-4000-8000-000000000001",
      "name": "Chat Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "student-chat-webhook"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8000/query-ai",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ user_question: $json.body.question, session_id: $json.body.session_id || 'n8n-default' }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "b2c3d4e5-0002-4000-8000-000000000002",
      "name": "Ask FastAPI AI Agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ reply: $json.response, session_id: $json.session_id }) }}",
        "options": {}
      },
      "id": "b2c3d4e5-0003-4000-8000-000000000003",
      "name": "Send Reply",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [720, 300]
    }
  ],
  "connections": {
    "Chat Webhook": {
      "main": [[{ "node": "Ask FastAPI AI Agent", "type": "main", "index": 0 }]]
    },
    "Ask FastAPI AI Agent": {
      "main": [[{ "node": "Send Reply", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
