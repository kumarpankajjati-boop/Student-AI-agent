# Copy this file to ".env" (same folder) and edit it. Never upload the real .env to GitHub.

DATABASE_URL=sqlite:///./students.db

# ollama = local model on your laptop, gemini = Google cloud model
LLM_PROVIDER=ollama

# Local model
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Gemini (only if LLM_PROVIDER=gemini). Key from https://aistudio.google.com
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Logs
LOG_FILE=logs/app.log

# true = add 5 sample students on startup when the table is empty
SEED_DEMO_DATA=true
